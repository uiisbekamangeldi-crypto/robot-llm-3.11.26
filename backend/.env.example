APP_NAME=robot-llm
APP_ENV=development
LOG_LEVEL=INFO
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://robot:change-me@127.0.0.1:25432/robot_llm
